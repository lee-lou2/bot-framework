#!/usr/bin/env python3
"""demo-agenda: simulated synthetic agenda MCP tool server over stdio (stdlib only).

Runs from a read-only install in an empty per-call workspace with no network, secrets, or disk writes:
- `list` returns built-in synthetic events.
- `delete` accepts only those IDs and returns a simulated receipt (not permanently deleted).
Receipts are deterministic per logical call (`_meta` `bot/profile-id`, `bot/run-id`, `bot/call-id`);
`bot/generation` is excluded so retries and handovers produce the same receipt.

Usage: bin/server --stdio   (one JSON-RPC message per line: initialize, ping, tools/list, tools/call)
"""
import hashlib
import json
import sys

SERVER = {"name": "demo-agenda", "version": "0.1.0"}
PROTOCOLS = ("2025-06-18", "2025-03-26", "2024-11-05")
MAX_LINE = 1 << 20

EVENTS = (
    {"id": "e-walk", "title": "Walk", "start": "07:30"},
    {"id": "e-meet", "title": "Team meeting", "start": "14:00"},
    {"id": "e-read", "title": "Reading", "start": "21:00"},
)
KNOWN = {event["id"]: event for event in EVENTS}

# Input schemas must stay identical to examples/profiles/personal/agents/main/skills/agenda/tools.yaml.
TOOLS = [
    {
        "name": "list",
        "description": "List today's synthetic events (read-only, simulated).",
        "inputSchema": {"type": "object", "properties": {}, "additionalProperties": False},
    },
    {
        "name": "delete",
        "description": "Return a simulated delete receipt for one synthetic event (not permanently deleted).",
        "inputSchema": {
            "type": "object",
            "required": ["event"],
            "properties": {"event": {"type": "string"}},
            "additionalProperties": False,
        },
    },
]


def emit(stream, text):
    """Write raw UTF-8 bytes so output stays valid regardless of locale (e.g. LC_ALL=C)."""
    stream.buffer.write(text.encode("utf-8"))
    stream.flush()


def reply(message_id, **body):
    emit(sys.stdout, json.dumps({"jsonrpc": "2.0", "id": message_id, **body}, ensure_ascii=False) + "\n")


def error(message_id, code, message):
    reply(message_id, error={"code": code, "message": message})


def outcome(payload, failed=False):
    return {"content": [{"type": "text", "text": json.dumps(payload, ensure_ascii=False)}], "isError": failed}


def call_identity(meta):
    """Logical call key [profile-id, run-id, call-id]; missing or non-string fields become ''."""
    meta = meta if isinstance(meta, dict) else {}
    return [meta[key] if isinstance(meta.get(key), str) else "" for key in ("bot/profile-id", "bot/run-id", "bot/call-id")]


def list_events(arguments, _identity):
    if arguments:
        return outcome({"error": "invalid-input", "message": "list takes no arguments"}, failed=True)
    return outcome({"simulated": True, "events": list(EVENTS)})


def delete_event(arguments, identity):
    event = arguments.get("event")
    if set(arguments) != {"event"} or not isinstance(event, str):
        return outcome({"error": "invalid-input", "message": "expected only string argument 'event'"}, failed=True)
    found = KNOWN.get(event)
    if found is None:
        shown = event[:64]
        return outcome(
            {"error": "unknown-event", "message": f"unknown synthetic event ID: {shown}", "known": sorted(KNOWN)},
            failed=True,
        )
    keyed = json.dumps([*identity, event], ensure_ascii=False, separators=(",", ":"))  # JSON array avoids field-boundary ambiguity
    digest = hashlib.sha256(keyed.encode("utf-8")).hexdigest()[:12]
    return outcome(
        {
            "simulated": True,
            "persisted": False,
            "receipt": f"sim-{digest}",
            "event": found["id"],
            "title": found["title"],
            "message": "Simulated delete receipt. This example server runs from a read-only install in an empty workspace, so no real event is deleted (not permanently deleted).",
        }
    )


HANDLERS = {"list": list_events, "delete": delete_event}


def initialize(params):
    asked = params.get("protocolVersion") if isinstance(params, dict) else None
    return {
        "protocolVersion": asked if asked in PROTOCOLS else PROTOCOLS[0],
        "capabilities": {"tools": {"listChanged": False}},
        "serverInfo": SERVER,
    }


def call_tool(params):
    if not isinstance(params, dict) or not isinstance(params.get("name"), str):
        return None, (-32602, "missing 'name'")
    handler = HANDLERS.get(params["name"])
    if handler is None:
        return None, (-32602, f"unknown tool: {params['name'][:64]}")
    arguments = params.get("arguments", {})
    if not isinstance(arguments, dict):
        return outcome({"error": "invalid-input", "message": "arguments must be an object"}, failed=True), None
    return handler(arguments, call_identity(params.get("_meta"))), None


def handle(line):
    try:
        message = json.loads(line)
    except ValueError:
        return error(None, -32700, "invalid JSON")
    if not isinstance(message, dict) or not isinstance(message.get("method"), str):
        return error(message.get("id") if isinstance(message, dict) else None, -32600, "invalid request")
    method, message_id, params = message["method"], message.get("id"), message.get("params")
    if "id" not in message:
        return  # Notifications (e.g. notifications/initialized) expect no response
    if method == "initialize":
        reply(message_id, result=initialize(params))
    elif method == "ping":
        reply(message_id, result={})
    elif method == "tools/list":
        reply(message_id, result={"tools": TOOLS})
    elif method == "tools/call":
        result, failure = call_tool(params)
        if failure:
            error(message_id, *failure)
        else:
            reply(message_id, result=result)
    else:
        error(message_id, -32601, "method not found")


def serve():
    for raw in iter(lambda: sys.stdin.buffer.readline(MAX_LINE + 1), b""):
        if len(raw) > MAX_LINE:
            error(None, -32600, "line too long")
            while not raw.endswith(b"\n") and raw:  # Drain remaining bytes of the overlong line
                raw = sys.stdin.buffer.readline(MAX_LINE + 1)
            continue
        line = raw.decode("utf-8", errors="replace").strip()
        if line:
            handle(line)


def main(argv):
    if argv[1:] == ["--stdio"]:
        serve()
        return 0
    emit(sys.stderr, "usage: bin/server --stdio\n")
    return 0 if argv[1:] in (["-h"], ["--help"]) else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
