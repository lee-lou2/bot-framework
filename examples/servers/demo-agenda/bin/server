#!/usr/bin/env python3
"""demo-agenda: README 5분 시작용 합성 일정 도구 서버(MCP, 표준 입출력). Python 표준 라이브러리만 쓴다.

시뮬레이션이다. 설치본은 읽기 전용이고 호출마다 빈 작업 공간에서 새 프로세스로 돌기 때문에 아무것도 저장하지 못한다.
- `list`는 내장된 합성 일정(산책 포함)을 돌려준다.
- `delete`는 그 합성 일정 ID만 받고 **가상 삭제 영수증**을 돌려준다. 영구 삭제가 아니며 결과에도 그렇게 적힌다.
외부 접속·자격·파일 쓰기가 없다. 같은 논리 호출이면 영수증도 같다(재시도·인계에 안전). 논리 호출은 `_meta`의
`bot/profile-id`·`bot/run-id`·`bot/call-id` 셋을 함께 본다: call-id는 run 안의 위치라 다른 run의 첫 호출끼리 겹칠 수 있다.
`bot/generation`은 재시도·인계 때 바뀌므로 넣지 않는다.

사용: bin/server --stdio   (줄 하나가 JSON-RPC 메시지 하나. initialize · ping · tools/list · tools/call)
"""
import hashlib
import json
import sys

SERVER = {"name": "demo-agenda", "version": "0.1.0"}
PROTOCOLS = ("2025-06-18", "2025-03-26", "2024-11-05")
MAX_LINE = 1 << 20

EVENTS = (
    {"id": "e-walk", "title": "산책", "start": "07:30"},
    {"id": "e-meet", "title": "팀 회의", "start": "14:00"},
    {"id": "e-read", "title": "독서", "start": "21:00"},
)
KNOWN = {event["id"]: event for event in EVENTS}

# 입력 스키마는 examples/profiles/personal/agents/main/skills/agenda/tools.yaml의 input과 같아야 한다(시험이 대조한다).
TOOLS = [
    {
        "name": "list",
        "description": "오늘의 합성 일정을 조회한다(읽기 전용, 시뮬레이션).",
        "inputSchema": {"type": "object", "properties": {}, "additionalProperties": False},
    },
    {
        "name": "delete",
        "description": "합성 일정 하나의 가상 삭제 영수증을 돌려준다. 시뮬레이션이라 영구 삭제가 아니다.",
        "inputSchema": {
            "type": "object",
            "required": ["event"],
            "properties": {"event": {"type": "string"}},
            "additionalProperties": False,
        },
    },
]


def emit(stream, text):
    """로캘과 무관하게 UTF-8 바이트로 쓴다(빈 환경에서도 한글이 깨지지 않는다)."""
    stream.buffer.write(text.encode("utf-8"))
    stream.flush()


def reply(message_id, **body):
    emit(sys.stdout, json.dumps({"jsonrpc": "2.0", "id": message_id, **body}, ensure_ascii=False) + "\n")


def error(message_id, code, message):
    reply(message_id, error={"code": code, "message": message})


def outcome(payload, failed=False):
    return {"content": [{"type": "text", "text": json.dumps(payload, ensure_ascii=False)}], "isError": failed}


def call_identity(meta):
    """같은 논리 호출을 가리키는 [profile-id, run-id, call-id]. 없거나 문자열이 아닌 필드는 빈 문자열이다."""
    meta = meta if isinstance(meta, dict) else {}
    return [meta[key] if isinstance(meta.get(key), str) else "" for key in ("bot/profile-id", "bot/run-id", "bot/call-id")]


def list_events(arguments, _identity):
    if arguments:
        return outcome({"error": "invalid-input", "message": "list는 인자가 없어요"}, failed=True)
    return outcome({"simulated": True, "events": list(EVENTS)})


def delete_event(arguments, identity):
    event = arguments.get("event")
    if set(arguments) != {"event"} or not isinstance(event, str):
        return outcome({"error": "invalid-input", "message": "event(문자열) 하나만 받아요"}, failed=True)
    found = KNOWN.get(event)
    if found is None:
        shown = event[:64]
        return outcome(
            {"error": "unknown-event", "message": f"합성 일정 ID가 아니에요: {shown}", "known": sorted(KNOWN)},
            failed=True,
        )
    keyed = json.dumps([*identity, event], ensure_ascii=False, separators=(",", ":"))  # JSON 배열이라 필드 경계가 모호하지 않다
    digest = hashlib.sha256(keyed.encode("utf-8")).hexdigest()[:12]
    return outcome(
        {
            "simulated": True,
            "persisted": False,
            "receipt": f"sim-{digest}",
            "event": found["id"],
            "title": found["title"],
            "message": "가상 삭제 영수증이에요. 이 예시 서버는 읽기 전용 설치본과 빈 작업 공간에서 돌아 실제 일정은 지워지지 않아요(영구 삭제 아님).",
        }
    )


HANDLERS = {"list": list_events, "delete": delete_event}


def initialize(params):
    asked = params.get("protocolVersion") if isinstance(params, dict) else None
    return {
        "protocolVersion": asked if asked in PROTOCOLS else PROTOCOLS[0],
        "capabilities": {"tools": {"listChanged": False}},
        "serverInfo": SERVER,
    }


def call_tool(params):
    """(결과, None) 또는 (None, (코드, 메시지))"""
    if not isinstance(params, dict) or not isinstance(params.get("name"), str):
        return None, (-32602, "name이 필요해요")
    handler = HANDLERS.get(params["name"])
    if handler is None:
        return None, (-32602, f"없는 도구예요: {params['name'][:64]}")
    arguments = params.get("arguments", {})
    if not isinstance(arguments, dict):
        return outcome({"error": "invalid-input", "message": "arguments는 객체여야 해요"}, failed=True), None
    return handler(arguments, call_identity(params.get("_meta"))), None


def handle(line):
    try:
        message = json.loads(line)
    except ValueError:
        return error(None, -32700, "JSON을 읽지 못했어요")
    if not isinstance(message, dict) or not isinstance(message.get("method"), str):
        return error(message.get("id") if isinstance(message, dict) else None, -32600, "요청이 올바르지 않아요")
    method, message_id, params = message["method"], message.get("id"), message.get("params")
    if "id" not in message:
        return  # 알림(notifications/initialized 등)에는 답하지 않는다
    if method == "initialize":
        reply(message_id, result=initialize(params))
    elif method == "ping":
        reply(message_id, result={})
    elif method == "tools/list":
        reply(message_id, result={"tools": TOOLS})
    elif method == "tools/call":
        result, failure = call_tool(params)
        if failure:
            error(message_id, *failure)
        else:
            reply(message_id, result=result)
    else:
        error(message_id, -32601, "method not found")


def serve():
    for raw in iter(lambda: sys.stdin.buffer.readline(MAX_LINE + 1), b""):
        if len(raw) > MAX_LINE:
            error(None, -32600, "줄이 너무 길어요")
            while not raw.endswith(b"\n") and raw:  # 남은 줄을 버린다
                raw = sys.stdin.buffer.readline(MAX_LINE + 1)
            continue
        line = raw.decode("utf-8", errors="replace").strip()
        if line:
            handle(line)


def main(argv):
    if argv[1:] == ["--stdio"]:
        serve()
        return 0
    emit(sys.stderr, "사용법: bin/server --stdio\n")
    return 0 if argv[1:] in (["-h"], ["--help"]) else 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
