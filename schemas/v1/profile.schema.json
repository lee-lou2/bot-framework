              {
                "pattern": "^[a-z0-9-]{1,63}(?:/[a-z0-9-]{1,63})*$"
              }
            ]
          }
        },
        "approve": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
