{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "triggers",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "triggers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trigger"
      }
    }
  },
  "required": [
    "version",
    "triggers"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "cron": {
              "type": "string",
              "pattern": "^[ \\t\\r\\n\u000b\u000c\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]*(?:@(?:hourly|daily|midnight|weekly|monthly|yearly|annually)|[^@ \\t\\r\\n\u000b\u000c\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000][^ \\t\\r\\n\u000b\u000c\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]*(?:[ \\t\\r\\n\u000b\u000c\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]+[^ \\t\\r\\n\u000b\u000c\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]+){4})[ \\t\\r\\n\u000b\u000c\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]*$"
            }
          },
          "required": [
            "cron"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "maxLength": 63
            },
            "binding": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "maxLength": 63
            }
          },
          "required": [
            "event",
            "binding"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "http": {
              "type": "object",
              "properties": {
                "method": {
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "DELETE",
                    "PATCH"
                  ]
                },
                "path": {
                  "type": "string",
                  "pattern": "^/[^?#]*$"
                }
              },
              "required": [
                "method",
                "path"
              ],
              "additionalProperties": false
            },
            "binding": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "maxLength": 63
            }
          },
          "required": [
            "http",
            "binding"
          ],
          "additionalProperties": false
        }
      ]
    },
    "trigger": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 63
        },
        "on": {
          "$ref": "#/$defs/source"
        },
        "principal": {
          "type": "string",
          "minLength": 1
        },
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                  "allOf": [
                    {
                      "pattern": "^[a-z0-9-]{1,63}\\.[a-z0-9-]{1,63}$"
                    }
                  ]
                },
                "args": {
                  "type": "object",
                  "additionalProperties": {}
                }
              },
              "required": [
                "tool"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "instruction": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "instruction"
              ],
              "additionalProperties": false
            }
          ]
        },
        "order": {
          "type": "integer"
        },
        "private": {
          "type": "boolean"
        },
        "private_pass": {
          "type": "boolean"
        },
        "match": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "boolean",
              "integer",
              "number",
              "null"
            ]
          },
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "response": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "sync",
                "accepted"
              ]
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        "beat": {
          "type": "boolean"
        },
        "preapproved": {
          "type": "object",
          "properties": {
            "max_per_day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "targets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "properties": {
                  "operation": {
                    "type": "string",
                    "maxLength": 128,
                    "pattern": "^(?:\\.|\\.?[A-Za-z0-9_:#@+\\-]+(?:\\.[A-Za-z0-9_:#@+\\-]+)*\\.?)$"
                  },
                  "target": {
                    "type": "string",
                    "maxLength": 128,
                    "pattern": "^(?:\\.|\\.?[A-Za-z0-9_:#@+\\-]+(?:\\.[A-Za-z0-9_:#@+\\-]+)*\\.?)$"
                  }
                },
                "required": [
                  "operation",
                  "target"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "max_per_day",
            "targets"
          ],
          "additionalProperties": false
        },
        "human_approval": {
          "type": "object",
          "properties": {
            "approvers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^slack:[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[UW][A-Z0-9]{1,31}$",
                "maxLength": 102
              }
            }
          },
          "required": [
            "approvers"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "on",
        "target"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "on": {
                "required": [
                  "cron"
                ]
              }
            }
          },
          "then": {
            "required": [
              "principal"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "principal"
                  ]
                },
                {
                  "required": [
                    "approver"
                  ]
                },
                {
                  "required": [
                    "beat"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "response"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "on": {
                "required": [
                  "http"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "private"
            ],
            "properties": {
              "private": {
                "const": true
              }
            }
          },
          "then": {
            "allOf": [
              {
                "properties": {
                  "on": {
                    "required": [
                      "event"
                    ]
                  }
                }
              },
              {
                "properties": {
                  "target": {
                    "required": [
                      "tool"
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
