# Model VM image: minimal Apple container VM image for OpenAI Codex CLI (`codex`).
# Built locally and pinned by digest (`images/model/build.sh --cli codex`; see docs/model-image.md). Not distributed.
#
# - Layout: digest-pinned Alpine + nftables/setpriv + pinned `codex` (linux-arm64 musl), stripped of apk and unused
#   busybox links, flattened to a single layer. Shares `bot-init` (relay-only nftables + privilege drop to 10001:10001)
#   and `bot-anchor` with the Claude model image.
# - Supply chain: base image pinned by digest; `CODEX_VERSION` and `CODEX_SHA256` must be pinned explicitly via
#   `--build-arg` (fail-closed if empty or mismatched). Default URL fetches the official musl release tarball from
#   `https://github.com/openai/codex/releases/download/rust-v<CODEX_VERSION>/codex-aarch64-unknown-linux-musl.tar.gz`.

ARG BUILDER=docker.io/library/alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

# ---- Stage 1 (discarded): fetch Codex CLI and verify pinned SHA-256 ------------------------------------------------
FROM ${BUILDER} AS fetch
ARG CODEX_VERSION=
ARG CODEX_SHA256=
ARG CODEX_URL=

RUN set -eu; \
    [ "$(uname -m)" = aarch64 ] || { echo "arm64 (Apple silicon) only: $(uname -m)" >&2; exit 1; }; \
    [ -n "$CODEX_VERSION" ] || { echo "CODEX_VERSION must be pinned (--build-arg CODEX_VERSION=...)" >&2; exit 1; }; \
    [ -n "$CODEX_SHA256" ] || { echo "CODEX_SHA256 must be pinned (--build-arg CODEX_SHA256=...)" >&2; exit 1; }; \
    apk add --no-cache curl tar >/dev/null; \
    cd /tmp; \
    url="${CODEX_URL:-https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-aarch64-unknown-linux-musl.tar.gz}"; \
    curl -fsSL "$url" -o codex.tar.gz; \
    echo "$CODEX_SHA256  codex.tar.gz" | sha256sum -c - >/dev/null || { echo "downloaded codex checksum mismatch" >&2; exit 1; }; \
    tar -xzf codex.tar.gz; \
    bin="$(find . -maxdepth 2 -type f \( -name 'codex' -o -name 'codex-aarch64-unknown-linux-musl' \) | head -n 1)"; \
    [ -n "$bin" ] || { echo "codex binary not found in archive" >&2; exit 1; }; \
    install -m 0555 "$bin" /codex

# ---- Stage 2 (discarded): assemble rootfs and strip unused tools ---------------------------------------------------
FROM ${BUILDER} AS rootfs
ARG CODEX_VERSION=
RUN apk add --no-cache nftables setpriv >/dev/null \
 && { echo "codex-cli $CODEX_VERSION"; echo "alpine $(cat /etc/alpine-release)"; apk list -I 2>/dev/null | sort; } > /etc/bot-model-image
COPY --from=fetch /codex /usr/local/bin/codex
COPY bot-init bot-anchor /usr/local/bin/
RUN set -eu; \
    chmod 0555 /usr/local/bin/bot-init /usr/local/bin/bot-anchor; \
    printf 'bot:x:10001:10001:model:/work/home:/nonexistent\n' >> /etc/passwd; \
    printf 'bot:x:10001:\n' >> /etc/group; \
    mkdir -p /bot /work; \
    chmod 1777 /tmp; \
    chmod 0700 /usr/sbin/nft /bin/setpriv; \
    rm -rf /sbin/apk /etc/apk /lib/apk /var/cache/apk /usr/share/apk; \
    /bin/busybox find /bin /sbin /usr/bin /usr/sbin -type l | while read -r link; do \
      case "$(/bin/busybox readlink "$link")" in \
        *busybox) case "$link" in /bin/sh | /bin/sleep) ;; *) /bin/busybox rm -f "$link" ;; esac ;; \
      esac; \
    done

# ---- Stage 3 (final image): flatten rootfs into a single layer -----------------------------------------------------
FROM scratch
ARG CODEX_VERSION=
COPY --from=rootfs / /
LABEL org.opencontainers.image.title="bot-model-codex" \
      org.opencontainers.image.description="Codex CLI for the bot-framework model VM (locally built; not distributed)" \
      org.opencontainers.image.licenses="NOASSERTION" \
      bot.codex-cli.version="${CODEX_VERSION}"

ENV PATH=/usr/local/bin:/usr/bin:/bin \
    HOME=/work/home \
    CODEX_HOME=/work/codex \
    NO_COLOR=1 \
    DO_NOT_TRACK=1

USER 0:0
ENTRYPOINT ["/usr/local/bin/bot-init"]
CMD ["codex", "--version"]
