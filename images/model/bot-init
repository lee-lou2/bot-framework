#!/bin/sh
# Trusted model VM init (ENTRYPOINT, docs/model-image.md):
#   1. Apply nftables rules allowing only relay TCP (BOT_RELAY_IP:BOT_RELAY_PORT) and its replies; drop all else (incl. IPv6).
#   2. Read back and verify the applied nftables rules.
#   3. Self-check privilege drop (10001:10001, no groups, zero caps, no_new_privs) via /proc/self/status.
#   4. Exec /usr/local/bin/<cli> (`claude`, `codex`, or `agy`) with the same dropped privileges.
#      For `agy`, also materialize RAM-only /tmp/mcp_config.json (0600, 10001:10001) from /work/mcp.agy.template.json
#      after dropping privileges so the session token never touches disk.
# Requires host-provided BOT_RELAY_IP (RFC 1918 IPv4), BOT_RELAY_PORT (1..65535), args `<cli> <args...>`,
# and only NET_ADMIN, SETUID, SETGID, SETPCAP. Missing SETPCAP causes setpriv to silently skip clearing the
# bounding set, which step 3 catches. Fails closed with exit 1 and single-word stderr `vm_init_failed`.
unset ENV BASH_ENV LD_PRELOAD LD_LIBRARY_PATH
PATH=/usr/sbin:/usr/bin:/bin
fail() { echo vm_init_failed >&2; exit 1; }

cli=${1-}
case $cli in
  claude | codex | agy) ;;
  *) fail ;;
esac
shift
[ -x "/usr/local/bin/$cli" ] || fail
ip=${BOT_RELAY_IP-}
port=${BOT_RELAY_PORT-}

# 0..255 without leading zeros
octet() {
  case $1 in
    0 | [1-9] | [1-9][0-9] | 1[0-9][0-9] | 2[0-4][0-9] | 25[0-5]) return 0 ;;
    *) return 1 ;;
  esac
}
case $ip in *.*.*.*) ;; *) fail ;; esac
a=${ip%%.*}; rest=${ip#*.}
b=${rest%%.*}; rest=${rest#*.}
c=${rest%%.*}; d=${rest#*.}
case $d in *.*) fail ;; esac
octet "$a" && octet "$b" && octet "$c" && octet "$d" || fail
# Relay must be an RFC 1918 private IPv4 host-only gateway address.
case $a.$b in
  10.* | 192.168 | 172.16 | 172.17 | 172.18 | 172.19 | 172.20 | 172.21 | 172.22 | 172.23 | 172.24 | 172.25 | 172.26 | 172.27 | 172.28 | 172.29 | 172.30 | 172.31) ;;
  *) fail ;;
esac
# 1..65535 without leading zeros
case $port in
  [1-9] | [1-9][0-9] | [1-9][0-9][0-9] | [1-9][0-9][0-9][0-9] | [1-5][0-9][0-9][0-9][0-9] | 6[0-4][0-9][0-9][0-9] | 65[0-4][0-9][0-9] | 655[0-2][0-9] | 6553[0-5]) ;;
  *) fail ;;
esac

# 1. Firewall: allow only relay TCP and established replies; `create table` fails if rules already exist.
/usr/sbin/nft -f - 2>/dev/null <<RULES || fail
create table inet bot_fw
table inet bot_fw {
  chain input {
    type filter hook input priority filter; policy drop;
    ip saddr $ip tcp sport $port ct state established accept
  }
  chain forward {
    type filter hook forward priority filter; policy drop;
  }
  chain output {
    type filter hook output priority filter; policy drop;
    ip daddr $ip tcp dport $port accept
  }
}
RULES

# 2. Read back and verify applied rules.
rules=$(/usr/sbin/nft list table inet bot_fw 2>/dev/null) || fail
for fragment in \
  "hook input priority filter; policy drop;" \
  "hook forward priority filter; policy drop;" \
  "hook output priority filter; policy drop;" \
  "ip saddr $ip tcp sport $port ct state established accept" \
  "ip daddr $ip tcp dport $port accept"; do
  case $rules in *"$fragment"*) ;; *) fail ;; esac
done

# 3. Verify dropped privileges via /proc/self/status before execing the model CLI.
unset BOT_RELAY_IP BOT_RELAY_PORT
privs="--reuid=10001 --regid=10001 --clear-groups --inh-caps=-all --ambient-caps=-all --bounding-set=-all --no-new-privs"
# shellcheck disable=SC2086
/bin/setpriv $privs -- /bin/sh -c '
  state=
  while read -r key a b c d; do
    case $key in
      Uid: | Gid:) state="$state $key$a,$b,$c,$d" ;;
      Groups: | CapInh: | CapPrm: | CapEff: | CapBnd: | CapAmb: | NoNewPrivs:) state="$state $key$a" ;;
    esac
  done </proc/self/status
  [ "$state" = " Uid:10001,10001,10001,10001 Gid:10001,10001,10001,10001 Groups: CapInh:0000000000000000 CapPrm:0000000000000000 CapEff:0000000000000000 CapBnd:0000000000000000 CapAmb:0000000000000000 NoNewPrivs:1" ]
' >/dev/null 2>&1 || fail

# 4. Exec pinned model CLI with the image PATH.
PATH=/usr/local/bin:/usr/bin:/bin
if [ "$cli" = agy ]; then
  # Expand ${RELAY_TOKEN} into RAM-only /tmp/mcp_config.json (0600, 10001:10001) using POSIX shell builtins only.
  # shellcheck disable=SC2086
  exec /bin/setpriv $privs -- /bin/sh -c '
    umask 077
    tpl=/work/mcp.agy.template.json
    if [ -f "$tpl" ]; then
      [ ! -L "$tpl" ] || { echo vm_init_failed >&2; exit 1; }
      tok=${RELAY_TOKEN-}
      [ -n "$tok" ] || { echo vm_init_failed >&2; exit 1; }
      line=
      IFS= read -r line <"$tpl" || [ -n "$line" ] || { echo vm_init_failed >&2; exit 1; }
      placeholder=\$\{RELAY_TOKEN\}
      replaced=0
      out=
      rest=$line
      while :; do
        case $rest in
          *"$placeholder"*)
            out=$out${rest%%"$placeholder"*}$tok
            rest=${rest#*"$placeholder"}
            replaced=1
            ;;
          *)
            out=$out$rest
            break
            ;;
        esac
      done
      [ "$replaced" = 1 ] || { echo vm_init_failed >&2; exit 1; }
      printf "%s\n" "$out" >/tmp/mcp_config.json || { echo vm_init_failed >&2; exit 1; }
    fi
    exec /usr/local/bin/agy "$@"
  ' agy "$@"
fi
# shellcheck disable=SC2086
exec /bin/setpriv $privs -- "/usr/local/bin/$cli" "$@"
