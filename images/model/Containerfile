# Model VM image: minimal Apple container VM image for Claude Code CLI (`claude`).
# Built locally and pinned by digest (`images/model/build.sh`; see docs/model-image.md). Not distributed.
#
# - Layout: digest-pinned Alpine + nftables/setpriv + pinned Claude Code, stripped of apk and unused busybox links,
#   flattened to a single layer. `bot-init` (ENTRYPOINT) starts as root, applies a relay-only nftables firewall,
#   drops all capabilities with no_new_privs, and execs Claude as 10001:10001. `bot-anchor` is a separate non-root,
#   zero-capability idle entrypoint.
# - Supply chain: base image pinned by digest; CLI pinned by version and SHA-256. `manifest.json` must pass GPG
#   verification against the pinned Anthropic key fingerprint, and manifest/pinned/downloaded checksums must all match.
#   Installed package versions/licenses are recorded in /etc/bot-model-image.
# - Adapter contract (`crates/bot-runtime/src/model/container`): read-only rootfs with tmpfs /tmp, read-only /bot
#   workdir, per-run writable /work (HOME=/work/home, CLAUDE_CONFIG_DIR=/work/claude), no DNS, host-only network,
#   `--cap-drop ALL` plus only the caps needed by `bot-init`, and `BOT_RELAY_IP`/`BOT_RELAY_PORT`.
#
# To bump Claude Code: verify the new `manifest.json` signature, read `platforms.linux-arm64-musl.checksum`, and
# update `CLAUDE_VERSION` and `CLAUDE_SHA256` together.

ARG BUILDER=docker.io/library/alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

# ---- Stage 1 (discarded): fetch Claude Code and verify signature and checksum --------------------------------------
FROM ${BUILDER} AS fetch
ARG CLAUDE_VERSION=2.1.331
ARG CLAUDE_SHA256=36bd0de0054eb2deff83d62b883e342a443aa3a82d030ec80dc7f9554df2a8d1
ARG CLAUDE_PLATFORM=linux-arm64-musl
# Anthropic Claude Code release signing primary key fingerprint (https://code.claude.com/docs/en/setup#binary-integrity-and-code-signing)
ARG CLAUDE_SIGNER_FPR=31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE
ARG CLAUDE_SITE=https://downloads.claude.ai

RUN set -eu; \
    [ "$(uname -m)" = aarch64 ] || { echo "arm64 (Apple silicon) only: $(uname -m)" >&2; exit 1; }; \
    apk add --no-cache curl gnupg jq >/dev/null; \
    export GNUPGHOME="$(mktemp -d)"; chmod 700 "$GNUPGHOME"; \
    cd /tmp; \
    base="$CLAUDE_SITE/claude-code-releases/$CLAUDE_VERSION"; \
    curl -fsSL "$CLAUDE_SITE/keys/claude-code.asc" -o key.asc; \
    fpr="$(gpg --batch --with-colons --import-options show-only --import key.asc | awk -F: '$1 == "fpr" { print $10; exit }')"; \
    [ "$fpr" = "$CLAUDE_SIGNER_FPR" ] || { echo "signing key fingerprint does not match pinned value" >&2; exit 1; }; \
    gpg --batch --quiet --import key.asc; \
    curl -fsSL "$base/manifest.json" -o manifest.json; \
    curl -fsSL "$base/manifest.json.sig" -o manifest.json.sig; \
    gpg --batch --status-fd 1 --verify manifest.json.sig manifest.json 2>/dev/null \
      | awk -v want="$CLAUDE_SIGNER_FPR" '$1 == "[GNUPG:]" && $2 == "VALIDSIG" && $NF == want { ok = 1 } END { exit ok ? 0 : 1 }' \
      || { echo "invalid manifest.json signature" >&2; exit 1; }; \
    [ "$(jq -r .version manifest.json)" = "$CLAUDE_VERSION" ] || { echo "manifest version mismatch" >&2; exit 1; }; \
    listed="$(jq -r --arg p "$CLAUDE_PLATFORM" '.platforms[$p].checksum // empty' manifest.json)"; \
    [ -n "$listed" ] || { echo "manifest missing $CLAUDE_PLATFORM entry" >&2; exit 1; }; \
    [ "$listed" = "$CLAUDE_SHA256" ] || { echo "signed manifest checksum does not match pinned value" >&2; exit 1; }; \
    curl -fsSL "$base/$CLAUDE_PLATFORM/claude" -o claude; \
    echo "$CLAUDE_SHA256  claude" | sha256sum -c - >/dev/null || { echo "downloaded claude checksum mismatch" >&2; exit 1; }; \
    install -m 0555 claude /claude

# ---- Stage 2 (discarded): assemble rootfs and strip unused tools ---------------------------------------------------
FROM ${BUILDER} AS rootfs
ARG CLAUDE_VERSION=2.1.331
RUN apk add --no-cache nftables setpriv >/dev/null \
 && { echo "claude-code $CLAUDE_VERSION"; echo "alpine $(cat /etc/alpine-release)"; apk list -I 2>/dev/null | sort; } > /etc/bot-model-image
COPY --from=fetch /claude /usr/local/bin/claude
COPY bot-init bot-anchor /usr/local/bin/
RUN set -eu; \
    chmod 0555 /usr/local/bin/bot-init /usr/local/bin/bot-anchor; \
    printf 'bot:x:10001:10001:model:/work/home:/nonexistent\n' >> /etc/passwd; \
    printf 'bot:x:10001:\n' >> /etc/group; \
    mkdir -p /bot /work; \
    chmod 1777 /tmp; \
    chmod 0700 /usr/sbin/nft /bin/setpriv; \
    # Remove package manager so nothing can be installed inside the image.
    rm -rf /sbin/apk /etc/apk /lib/apk /var/cache/apk /usr/share/apk; \
    # Keep only sh and sleep busybox links for bot-init and bot-anchor; invoke /bin/busybox directly while pruning.
    /bin/busybox find /bin /sbin /usr/bin /usr/sbin -type l | while read -r link; do \
      case "$(/bin/busybox readlink "$link")" in \
        *busybox) case "$link" in /bin/sh | /bin/sleep) ;; *) /bin/busybox rm -f "$link" ;; esac ;; \
      esac; \
    done

# ---- Stage 3 (final image): flatten rootfs into a single layer -----------------------------------------------------
FROM scratch
ARG CLAUDE_VERSION=2.1.331
COPY --from=rootfs / /
LABEL org.opencontainers.image.title="bot-model-vm" \
      org.opencontainers.image.description="Claude Code CLI for the bot-framework model VM (locally built; not distributed)" \
      org.opencontainers.image.licenses="NOASSERTION" \
      bot.claude-code.version="${CLAUDE_VERSION}"

# Disable nonessential traffic (auto-updates, telemetry, error reporting, feedback, feature flags, marketplace
# auto-install); mirrors ClaudeCodeRunner FIXED_ENV (https://code.claude.com/docs/en/env-vars).
ENV PATH=/usr/local/bin:/usr/bin:/bin \
    HOME=/work/home \
    CLAUDE_CONFIG_DIR=/work/claude \
    DISABLE_AUTOUPDATER=1 \
    DISABLE_UPDATES=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    DISABLE_TELEMETRY=1 \
    DISABLE_ERROR_REPORTING=1 \
    DO_NOT_TRACK=1 \
    DISABLE_FEEDBACK_COMMAND=1 \
    CLAUDE_CODE_DISABLE_FEATURE_FLAGS=1 \
    CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1 \
    CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL=1 \
    CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 \
    CLAUDE_CODE_DISABLE_BUNDLED_SKILLS=1

# bot-init starts as root to apply nftables rules and drop privileges; invocations missing caps or relay env fail closed.
USER 0:0
ENTRYPOINT ["/usr/local/bin/bot-init"]
CMD ["claude", "--version"]
