#!/bin/sh
# Idle anchor entrypoint (docs/model-image.md): keeps the host-only network gateway address alive
# before the adapter binds the relay listener. Separate from bot-init; refuses to run unless
# non-root with zero capabilities (--user 10001:10001 --cap-drop ALL), failing with `vm_anchor_failed`.
unset ENV BASH_ENV
PATH=/bin
fail() { echo vm_anchor_failed >&2; exit 1; }

uid=
caps=
while read -r key value _; do
  case $key in
    Uid:) uid=$value ;;
    CapInh: | CapPrm: | CapEff: | CapBnd: | CapAmb:) caps="$caps $value" ;;
  esac
done </proc/self/status
case $uid in '' | 0 | *[!0-9]*) fail ;; esac
[ "$caps" = " 0000000000000000 0000000000000000 0000000000000000 0000000000000000 0000000000000000" ] || fail
exec sleep 2147483647
